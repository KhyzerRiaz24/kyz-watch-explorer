# Optional. The catalogue and built-in advisor work without any credentials.
PORT=4177
HOST=127.0.0.1
DATABASE_PATH=./data/kyz.sqlite
# Generate a private key with npm run setup. Never prefix secrets with VITE_.
ADMIN_TOKEN=
# Optional AI mode. Configure both values to enable server-side generation.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set to 1 ONLY behind one trusted reverse proxy.
TRUST_PROXY=0
